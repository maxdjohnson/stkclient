{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "automerge": true,
  "dependencyDashboardApproval": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": true
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.readthedocs\\.yml$/"],
      "matchStrings": ["pip install uv==(?<currentValue>\\S+)"],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Pin development tools while keeping runtime library dependencies ranged",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development dependencies"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Keep uv CLI, build backend, CI and Read the Docs together",
      "matchDepNames": ["uv", "uv_build", "astral-sh/uv"],
      "groupName": "uv toolchain"
    },
    {
      "description": "Python maintenance stays on 3.12; support changes are deliberate",
      "matchManagers": ["asdf", "pyenv", "github-actions"],
      "matchDepNames": ["python"],
      "allowedVersions": "/^3\\.12\\./",
      "groupName": "maintenance Python"
    },
    {
      "matchDepTypes": ["requires-python"],
      "enabled": false
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "0 days",
    "addLabels": ["security"]
  }
}
